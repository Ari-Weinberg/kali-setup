DOCKER_KEY_FPR=9DC858229FC7DD38854AE2D88D81803C0EBFCD88
DOCKER_SUITE=trixie                       # Docker publishes per Debian stable release
NGROK_KEY_FPR=F0271FCF712CF2E39901F1A30E61D3BBAAEE37FE   # trust on first use: ngrok publishes no fingerprint
NGROK_SUITE=buster                        # ngrok's single suite for every Debian release

